# Copy PostgreSQL strings from your Supabase project's Connect panel.
# These values are placeholders. Keep the real .env file untracked.
# Use Direct connection or Session pooler (port 5432), not Transaction pooler.
DATABASE_URL=postgresql://<runtime-user>:<encoded-password>@<supabase-host>:5432/postgres
MIGRATION_DATABASE_URL=postgresql://<migration-user>:<encoded-password>@<supabase-host>:5432/postgres
DB_POOL_MAX=5
APP_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
