{
  "name": "nexora-backend",
  "version": "1.0.0",
  "description": "Nexora School Exam Platform \u2014 Master Backend API",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "npm run build -- --incremental false && node scripts/start-dev.mjs",
    "db:status": "tsx scripts/database-status.ts",
    "db:provision-runtime": "tsx scripts/provision-runtime.ts",
    "mfa:operator": "tsx scripts/mfa-operator.ts",
    "school:provision": "tsx scripts/mfa-operator.ts bootstrap",
    "db:backup": "tsx scripts/backup.ts backup",
    "db:restore": "tsx scripts/backup.ts restore",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed-staging.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run test/*.e2e-spec.ts",
    "worker": "npm run build && node dist/scripts/run-worker.js",
    "test:unit": "vitest run test/unit"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^5.11.2",
    "otplib": "^12.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.5",
    "yauzl": "^3.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/cookie-parser": "^1.4.8",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@types/yauzl": "^3.4.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
