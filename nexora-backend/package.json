{
  "name": "nexora-backend",
  "version": "1.0.0",
  "description": "Nexora School Exam Platform — Master Backend API",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "start:dev": "npm run build -- --incremental false && node dist/src/main.js",
    "db:status": "tsx scripts/database-status.ts",
    "db:provision-runtime": "tsx scripts/provision-runtime.ts",
    "mfa:operator": "tsx scripts/mfa-operator.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed-staging.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run test/*.e2e-spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "otplib": "^12.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/cookie-parser": "^1.4.8",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.0.4"
  }
}
